{
  "name": "contextforge-unreal",
  "version": "2.1.1",
  "description": "Thin ContextForge stdio adapter for Unreal Engine's official local MCP server.",
  "type": "module",
  "bin": {
    "contextforge-unreal": "bin/contextforge-unreal.mjs"
  },
  "files": [
    "bin",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check-version": "node scripts/check-version.mjs",
    "prepack": "npm run build && npm test && npm run check-version"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "esbuild": "0.25.10"
  },
  "keywords": [
    "contextforge",
    "mcp",
    "unreal-engine",
    "ue5"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Smangsty/contextforge-unreal",
  "repository": {
    "type": "git",
    "url": "https://github.com/Smangsty/contextforge-unreal.git"
  }
}
