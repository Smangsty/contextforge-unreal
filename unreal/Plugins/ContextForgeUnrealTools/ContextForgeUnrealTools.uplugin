{
  "FileVersion": 3,
  "Version": 20301,
  "VersionName": "2.3.1",
  "FriendlyName": "ContextForge Unreal Authoring Tools",
  "Description": "Engine-wide UE 5.8 editor authoring, diagnostics and PIE toolsets for Epic's official Unreal MCP registry.",
  "Category": "Editor",
  "CanContainContent": true,
  "Installed": true,
  "EnabledByDefault": true,
  "Modules": [
    {
      "Name": "ContextForgeUnrealTools",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit"
    }
  ],
  "Plugins": [
    {
      "Name": "ToolsetRegistry",
      "Enabled": true
    },
    {
      "Name": "ModelContextProtocol",
      "Enabled": true
    },
    {
      "Name": "PythonScriptPlugin",
      "Enabled": true
    },
    {
      "Name": "EditorScriptingUtilities",
      "Enabled": true
    }
  ]
}
